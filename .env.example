# ════════════════════════════════════════════════════════════════
# Маршрутизатор 3.0 — шаблон переменных окружения
# Скопируйте в .env и заполните реальными значениями:
#   cp .env.example .env
# ════════════════════════════════════════════════════════════════

# ─── Геокодирование ────────────────────────────────────────────
# Провайдер геокодирования. Компонент Geocoder должен позволять
# менять провайдера без переписывания остального приложения.
# Допустимые значения:
#   yandex | dadata | 2gis | google | opencage | nominatim
GEOCODER_PROVIDER=yandex

# Яндекс Геокодер
# https://developer.tech.yandex.ru/services/
YANDEX_GEOCODER_API_KEY=

# Яндекс.Маршрутизация (дорожные расстояния между точками).
# Если не задан, используется YANDEX_GEOCODER_API_KEY.
YANDEX_ROUTING_API_KEY=

# GraphHopper Matrix API (hosted, ключ).
GRAPHOPPER_API_KEY=

# OpenRouteService Matrix API (hosted, ключ).
OPENROUTESERVICE_API_KEY=

# Self-hosted OSRM — резервный источник дорожных расстояний (без ключа).
# Пример: OSRM_BASE_URL=http://localhost:5000
OSRM_BASE_URL=

# DaData — стандартизация и подсказки адресов
# https://dadata.ru/api/
DADATA_API_KEY=
DADATA_SECRET_KEY=

# 2ГИС Геокодер
# https://dev.2gis.ru/
TGIS_API_KEY=

# Google Maps Geocoding API
# https://console.cloud.google.com/google/maps-apis/
GOOGLE_MAPS_API_KEY=

# OpenCage Geocoder
# https://opencagedata.com/
OPENCAGE_API_KEY=

# Nominatim (OpenStreetMap) — работает без ключа.
# Укажите email для соблюдения политики использования сервиса.
NOMINATIM_EMAIL=

# ─── GitHub (доступ агента к репозиториям) ─────────────────────
# Personal Access Token. Нужен агенту для обновления репозиториев
# пользователя (push/pull). Рекомендуемые scope: repo (или доступ
# только к нужным репозиториям). Никогда не коммитьте .env.
GITHUB_ACCESS_KEY=
